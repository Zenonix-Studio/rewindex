{
  "name": "rewindex",
  "version": "0.1.1",
  "description": "git-free /undo for OpenAI Codex CLI — automatic shadow-git snapshots before every file-mutating tool call, restore with one command. Never touches your project's git history.",
  "keywords": [
    "codex",
    "codex-cli",
    "undo",
    "rewind",
    "checkpoint",
    "snapshot",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenonix-studio/rewindex.git"
  },
  "homepage": "https://github.com/zenonix-studio/rewindex#readme",
  "bugs": {
    "url": "https://github.com/zenonix-studio/rewindex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "bin": {
    "rewindex": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "selfcheck": "node selfcheck.js",
    "prepublishOnly": "npm run build",
    "edgecheck": "node edgecheck.js",
    "installcheck": "node installcheck.js",
    "historycheck": "node historycheck.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
